      {
        "id": "breach",
        "trigger": "lesion.breached",
        "consequence": "Fat spills, the plane is lost, fragments recur.",
        "teaching": "Stay on the shiny capsule: blunt spread with closed scissors or hemostat, light cut on the capsule surface only."
      },
      {
        "id": "edge-burn",
        "trigger": "dermalEdgeDamage>1.0",
        "consequence": "Wide scar, dehiscence risk.",
        "teaching": "Cut mode, steady pace through dermis; coag only on bleeders."
      },
      {
        "id": "held-coag",
        "trigger": "carbonized",
        "consequence": "Char: insulating, delays healing.",
        "teaching": "Lift off; short taps."
      }
    ],
    "decisionPoints": [
      {
        "id": "feeder",
        "trigger": "vessel.exposed",
        "prompt": "A feeding vessel at the base is bleeding. Grasp and buzz, or tie?",
        "options": [
          {
            "label": "Grasp and buzz",
            "outcome": "Fine for the usual < 1.5 mm feeder."
          },
          {
            "label": "Tie",
            "outcome": "Secure; slower."
          }
        ]
      },
      {
        "id": "plane",
        "trigger": "tissue.fasciaContact",
        "prompt": "You are at the deep fascia under the lipoma. Stay above it?",
        "options": [
          {
            "label": "Stay above",
            "outcome": "Correct for a subcutaneous lipoma."
          },
          {
            "label": "Go through",
            "outcome": "Muscle bleeding and twitching; nothing gained."
          }
        ]
      }
    ],
    "ambiguity": [
